# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# --- Core Django settings ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (MySQL) ---
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Email (contact form notifications) ---
# Leave blank to fall back to console-only email output during development.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Misc ---
SITE_URL=http://localhost:8000

# --- Admin panel: GitHub repo browser (read-only) ---
# Create a fine-grained Personal Access Token scoped to read-only
# "Contents" and "Metadata" access on the repos you want visible here.
# (Classic tokens with the "repo" scope also work, but that scope grants
# write access too -- prefer fine-grained + read-only where possible, since
# this feature never needs to write anything.) Leave blank to hide the
# GitHub pages in the admin panel.
GITHUB_TOKEN=

# --- Admin panel: File Manager ---
# Per-file upload size limit, in bytes. Defaults to 50MB if unset.
FILE_MANAGER_MAX_UPLOAD_SIZE=52428800
